# Налаштування, спільні для обох плат.
#
# Файл читається лише при першому `idf.py set-target` / `reconfigure`.
# Уже створений `sdkconfig` він не перезаписує — якщо міняєш щось тут,
# видали `sdkconfig` і збери наново.

# --- WebSocket у вбудованому сервері --------------------------------------
# Заради нього й обрано ESP-IDF замість Arduino (ADR-0004): esp_http_server
# уміє WebSocket сам, тому ESPAsyncWebServer + AsyncTCP не потрібні.
CONFIG_HTTPD_WS_SUPPORT=y

# --- місце під прошивку ----------------------------------------------------
# Wi-Fi, TCP/IP і HTTP-сервер разом не влазять у типовий розділ на 1 МБ.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Обидві плати — 4 МБ. Без цього збірка вважає флеш 2 МБ і команда заливки
# виходить із заниженим розміром.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- швидкість реакції -----------------------------------------------------
# Такт 1 мс замість 10: ми міряємо затримку від дотику до зміни на екрані,
# і 10 мс гранулярності планувальника лягли б просто в неї.
CONFIG_FREERTOS_HZ=1000

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- потік в один бік ------------------------------------------------------
# Пульт віддає до ~90 КіБ/с суцільним потоком, назад іде 80 Б/с. Вікно за
# замовчуванням (5744 Б) робить вузьким місцем саме TCP.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
