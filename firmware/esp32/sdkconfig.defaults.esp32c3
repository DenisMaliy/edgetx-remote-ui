# ESP32-C3 SuperMini — кандидат у корпус.
#
# Логи йдуть через власний USB (USB Serial/JTAG), тому UART0 лишається
# вільним, а наш UART1 на GPIO4/5 не змагається з консоллю за піни.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Одне ядро: Wi-Fi і приймання UART ділять його. Буфери менші (bridge_cfg.h),
# і 921600 тут — стеля, а не проміжна швидкість.
